# Azure OpenAI
AZURE_OPENAI_API_KEY=placeholder
AZURE_OPENAI_ENDPOINT=placeholder
AZURE_OPENAI_API_VERSION=placeholder
AZURE_OPENAI_DEPLOYMENT=placeholder

# Weather (Open-Meteo requires no key)
WEATHER_API_BASE=https://api.open-meteo.com/v1

# App
DEFAULT_LAT=40.8475
DEFAULT_LON=25.8744
DEFAULT_TIMEZONE=Europe/Athens

# Conversation
HISTORY_TURNS_TO_LLM=6
DEFAULT_PLAN_HOURS=4.0
DEFAULT_PLAN_START_OFFSET_HOURS=1
WEATHER_FORECAST_HOURS=6

# RAG retrieval
RAG_TOP_K_FACTUAL=4
RAG_TOP_K_RECOMMENDATION=5
RAG_TOP_K_PLAN=8
RAG_TOP_K_REPLACEMENT=5

# Prompt guard
PROMPT_GUARD_MODEL=skshreyas714/prompt-guard-finetuned
PROMPT_GUARD_THRESHOLD=0.5
PROMPT_GUARD_MAX_TOKENS=512